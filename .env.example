BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_IDS=111111111,222222222
WEBAPP_URL=https://your-mini-app.example.com/

# Used to build t.me/<BOT_USERNAME>/<MINIAPP_SHORT_NAME>?startapp=... links
# attached to channel posts after publish. Must match what's registered in BotFather.
BOT_USERNAME=aktaviuseu_bot
MINIAPP_SHORT_NAME=shop
DATABASE_URL=sqlite+aiosqlite:///shop.db
API_HOST=0.0.0.0
API_PORT=8000

# Telegram channel to sync products from (without @)
CHANNEL_USERNAME=your_channel_username

# Database backup. The bot DMs a copy of shop.db here on a timer and on
# /backup. Leave BACKUP_CHAT_ID empty to send to the first admin (your
# Saved Messages). Set BACKUP_INTERVAL_HOURS=0 is not allowed — minimum 1.
BACKUP_CHAT_ID=
BACKUP_INTERVAL_HOURS=24

# Telethon credentials for one-time channel history import.
# Get these from https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
